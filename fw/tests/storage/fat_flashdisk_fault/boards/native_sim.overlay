/*
 * A fault-injectable flash controller under the same fat_storage/flash-disk
 * shape proto0 uses, but with proto0's REAL disk geometry (sector-size 4096 ==
 * erase page == FatFS sector, matching the Partition Manager extra_params),
 * unlike fat_corrupt's 512-byte sectors. The fault_flash driver in src/ backs
 * it with RAM and fails flash ops on command, which is the only way to
 * exercise the flashdisk error paths FatFS depends on (issue #380).
 */
/ {
	fault_flash: fault-flash {
		compatible = "test,fault-flash";
		size = <0x100000>;		/* 1 MB — f_mkfs needs >= 128 sectors at 4 KB */
		erase-block-size = <4096>;
		write-block-size = <4>;
		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			fat_storage: partition@0 {
				reg = <0x0 0x100000>;
			};
		};
	};

	msc_disk0 {
		compatible = "zephyr,flash-disk";
		partition = <&fat_storage>;
		disk-name = "NAND";
		cache-size = <4096>;
		sector-size = <4096>;
	};
};
