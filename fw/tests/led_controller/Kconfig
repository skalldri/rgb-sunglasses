source "Kconfig.zephyr"

# led_controller.cpp consumes these app symbols. They're defined in fw/Kconfig, which
# standalone Twister apps don't see — redeclared here with the same names and defaults.
# (Same pattern as fw/tests/imu/pipeline/Kconfig.)
config APP_LED_DISPLAY_THREAD_PRIORITY
	int "LED display thread priority"
	default 6

config APP_LED_DISPLAY_THREAD_STACK_SIZE
	int "LED display thread stack size (bytes)"
	default 4096

# Not used to create a thread here, but led_controller.cpp's ordering BUILD_ASSERT
# compares against it, so the assert is exercised in this suite too.
config APP_PATTERN_CONTROLLER_THREAD_PRIORITY
	int "Pattern controller (render) thread priority"
	default 6
