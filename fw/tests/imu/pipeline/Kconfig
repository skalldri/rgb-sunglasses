source "Kconfig.zephyr"

rsource "../../../drivers/Kconfig"

# imu.cpp consumes these two app symbols. They're defined in fw/Kconfig, which
# standalone Twister apps don't see — redeclared here with the same names and
# defaults.
config IMU_THREAD_PRIORITY
	int "IMU thread priority"
	default 7

config IMU_THREAD_STACK_SIZE
	int "IMU thread stack size (bytes)"
	default 1024

# imu.cpp's ordering BUILD_ASSERT compares against the pattern controller's priority.
# Redeclared with the same default as fw/Kconfig so the assert is exercised here too.
config APP_PATTERN_CONTROLLER_THREAD_PRIORITY
	int "Pattern controller (render) thread priority"
	default 6
