{
  "name": "rgbx-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Hardware-free simulator for rgbx animation extensions (WASM)",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.node.json",
    "test": "tsc -p tsconfig.node.json && node --test dist/test/",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "serve": "vite browser --host"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
