config APP_PERSIST_BT_CONFIG
	bool "Persist BT-settable configuration via the Settings subsystem"
	default y
	depends on SETTINGS
	help
	  Backs every BT-settable config characteristic (core_config, animation
	  parameters/strings/colors, glim selection/loop mode, last-active
	  animation, extension animation parameters) with Zephyr's settings
	  subsystem so values survive a power cycle. See src/settings/ and
	  src/bluetooth/persistent_characteristic.h.
	  The legacy rgb_sunglasses_dk board (maintained on the dk-support
	  branch) disables this in its board .conf: its internal-flash image
	  slot has no spare room, and it gets no new features.

config APP_PERSIST_WORKQ_STACK_SIZE
	int "Stack size for the persistent-value-store workqueue"
	default 2048
	depends on APP_PERSIST_BT_CONFIG
	help
	  The persistent-value-store workqueue is used to debounce writes to
	  persistent config values (see src/settings/). This option controls the
	  stack size of that workqueue's thread.

config APP_BT_METADATA_CHARACTERISTIC
	bool "Append a bulk CUD/CPF metadata characteristic to every BtGattServer service"
	default y
	help
	  Adds one extra read-only characteristic per GATT service (see
	  BtGattServer in src/bluetooth/bt_service_cpp.h) that returns every
	  sibling characteristic's CUD name + CPF format in a single packed
	  blob, so the companion app can read it in one ATT round-trip instead
	  of two descriptor reads per characteristic during discovery (issue
	  #41 follow-up). Costs real flash: the blob duplicates every
	  characteristic's CUD description string as packed binary data.
	  Also covers extension animation services (src/extensions/extension_bt.cpp,
	  issue #90 follow-up) — built at runtime there instead of at compile
	  time, so it costs RAM (a few hundred bytes per extension slot) rather
	  than flash and is not part of the flash-budget reasoning below.
	  The legacy rgb_sunglasses_dk board (maintained on the dk-support
	  branch) disables this in its board .conf: its internal-flash image
	  slot has no spare room, and it gets no new features.

config APP_BT_CONN_PARAM_GOVERNOR
	bool "Adaptive LE connection-parameter governor"
	default y
	depends on BT_PERIPHERAL
	help
	  Renegotiates LE connection parameters from observed activity (issue
	  #188): FAST (7.5-15ms, issue #41's discovery speed - unchanged) at
	  connect and during MCUmgr DFU uploads, MEDIUM (30-45ms) while the
	  user is actively interacting, SLOW (150-165ms + peripheral latency 2,
	  ~97% idle radio-duty cut on both ends) after a quiet window. The
	  firmware observes everything itself (it is the GATT and SMP server),
	  so no app coordination is needed - which is also the ONLY way to get
	  parameter policy on iOS, where apps have no central-side API. Decision
	  core: src/bluetooth/conn_param_governor_core.{h,cpp} (native_sim
	  suite tests/bluetooth/conn_param_governor); wiring in bluetooth.cpp.
	  When disabled the legacy behavior remains: one fast request at
	  connect, never renegotiated. The legacy rgb_sunglasses_dk board
	  (dk-support branch) disabled this in its board .conf (no new
	  features, no flash headroom).

config APP_BT_CONN_IDLE_TIMEOUT_S
	int "Quiet seconds before the link downgrades to the SLOW parameter set"
	default 20
	depends on APP_BT_CONN_PARAM_GOVERNOR
	help
	  Seconds without an inbound ATT operation or SMP command before the
	  governor requests the SLOW set. Every discovery read refreshes this
	  clock, so FAST naturally holds through the app's whole discovery walk
	  (including iOS's 30-55s one) and drops ~this long after it finishes.

config APP_BT_CONN_BOOST_HOLD_S
	int "Quiet seconds before an activity boost falls back to SLOW"
	default 10
	depends on APP_BT_CONN_PARAM_GOVERNOR
	help
	  An inbound ATT operation while the link is SLOW boosts it to MEDIUM;
	  the boost is held for a sliding window of this many quiet seconds
	  (each further operation refreshes it) before dropping back to SLOW.

config APP_BT_CONN_PARAM_MIN_REQUEST_SPACING_MS
	int "Minimum milliseconds between two governor parameter requests"
	default 2000
	depends on APP_BT_CONN_PARAM_GOVERNOR
	help
	  Rate bound on bt_conn_le_param_update() requests (anti-ping-pong): a
	  state transition that fires sooner after the previous request is
	  deferred and re-derived when the spacing elapses. The first request
	  after a connect is never deferred.

config APP_MCUBOOT_INFO_SERVICE
	bool "MCUboot version BLE service and shell command"
	default y
	depends on RETENTION_BOOTLOADER_INFO_TYPE_MCUBOOT
	help
	  Reads MCUboot's own version from the retained-SRAM TLV area written
	  at boot (BOOT_SHARE_DATA) and exposes it as a read-only BLE GATT
	  characteristic (McubootInfo service) and a Zephyr shell command
	  (mcuboot_version). Requires the zephyr,bootloader-info DTS chosen
	  node and the matching BOOT_SHARE_DATA Kconfig in the MCUboot image.
	  The legacy rgb_sunglasses_dk board (maintained on the dk-support
	  branch) disables this in its board .conf: it gets no new features,
	  and its internal-flash image slot has no spare room for the blinfo
	  stack.

config APP_MCUBOOT_UPDATER
	bool "BLE MCUboot bootloader updater (proto0 escape hatch)"
	default y if BOARD_RGB_SUNGLASSES_PROTO0_NRF5340_CPUAPP
	default n
	depends on FLASH && FLASH_MAP && APP_MCUBOOT_INFO_SERVICE
	help
	  Custom BLE-based mechanism to update the MCUboot bootloader in-field.
	  Receives the packaged binary over BLE, stores it in the external QSPI
	  staging partition, validates the CRC32, then page-by-page rewrites
	  internal flash 0x0-0x14000. Requires CONFIG_FPROTECT=n in the MCUboot
	  sysbuild conf so the SPU does not lock that region before jumping to the
	  app. Proto0 only — never offered on the legacy DK board (dk-support
	  branch).

config APP_MCUBOOT_UPDATER_STACK_SIZE
	int "MCUboot updater worker thread stack size"
	default 4096
	depends on APP_MCUBOOT_UPDATER

config APP_MCUBOOT_UPDATER_INIT_PRIORITY
	int "MCUboot updater SYS_INIT priority"
	default 90
	depends on APP_MCUBOOT_UPDATER
	help
	  APPLICATION-phase init priority for the MCUboot updater. Must run
	  after the flash subsystem (pre-APPLICATION). The default of 90 leaves
	  room above CONFIG_MCUBOOT_INFO_INIT_PRIORITY (88).

config APP_FACTORY_RESET
	bool "Boot-time two-phase factory reset (hold Up+Down)"
	default y if BOARD_RGB_SUNGLASSES_PROTO0_NRF5340_CPUAPP
	default n
	depends on FLASH_MAP
	help
	  On boot (SYS_INIT APPLICATION 0, before settings_load), if the Up and
	  Down D-PAD buttons are both held, pause boot and flash the status LEDs
	  white. The reset is two-phase (issue #265): after a continuous 10 s
	  hold the LEDs go solid white while the NVS settings partition is
	  erased (all config + BT bonds; the "soft" reset step), then switch to
	  flashing amber — releasing during that second window stops there and
	  reboots; keep holding through it and the LEDs go solid amber while
	  the rest of the full reset runs: the coredump partition and the FAT
	  filesystem (GLIM assets and extensions are lost). Releasing during
	  the first (white) phase resumes a normal boot with nothing erased.
	  Also registers the 'factory_reset now' and 'factory_reset soft'
	  shell commands. Up+Down rather than all 4 D-PAD buttons because Left
	  is MCUboot's serial-recovery entry button — see the header comment
	  in src/factory_reset/factory_reset.cpp. Proto0 only — the legacy DK
	  board (dk-support branch) lacks the status LEDs, FAT disk, and
	  coredump partition.

config APP_FACTORY_RESET_HOLD_MS
	int "Factory reset phase-1 hold duration (ms)"
	default 10000
	range 1000 3600000
	depends on APP_FACTORY_RESET
	help
	  How long the Up+Down chord must be held continuously at boot (LEDs
	  flashing white) before phase 1 completes and the phase-2 window
	  begins. The 1 s floor guarantees a release (cancel) window always
	  exists before the settings erase commits — a zero-duration phase
	  would erase on a single boot-time chord sample with no way to back
	  out.

config APP_FACTORY_RESET_PHASE2_HOLD_MS
	int "Factory reset phase-2 (full erase) additional hold duration (ms)"
	default 10000
	range 0 3600000
	depends on APP_FACTORY_RESET
	help
	  After the phase-1 hold completes (and the settings erase has run,
	  LEDs solid white), how much longer the chord must be held — LEDs
	  flashing amber — before the rest of the full reset (coredump + FAT)
	  runs. Releasing during this window stops at the settings-only reset
	  (whole NVS partition, BT bonds included — phones must re-pair) and
	  reboots. 0 restores the legacy single-phase full reset at the
	  phase-1 deadline.

config APP_SETTINGS_PARTITION_ERASE
	bool
	default y if APP_MCUBOOT_UPDATER || APP_FACTORY_RESET
	depends on FLASH_MAP
	help
	  Hidden helper symbol: compiles src/storage/appcfg_erase.cpp
	  (storage_erase_settings_partition() + the 'appcfg erase' shell
	  command) for every feature that needs it, so factory reset doesn't
	  have to borrow the unrelated APP_MCUBOOT_UPDATER gate.

config APP_SETTINGS_SAVE_DEBOUNCE_MS
	int "Debounce interval (ms) before persisting a changed config value"
	default 1000
	depends on SETTINGS
	help
	  How long to wait after the last write to a persistent config value
	  (see src/settings/) before flushing it to flash via the Settings
	  subsystem. Coalesces rapid successive writes (e.g. typing a text
	  string or dragging a color picker over BLE) into a single flash
	  write. This is app-owned and intentionally independent of
	  CONFIG_BT_SETTINGS_DELAYED_STORE_MS, which only governs Bluetooth's
	  own bonding/CCC storage.

config APP_WAKE_BUTTON
	bool "Enable the WAKE_N button input"
	default y
	help
	  Configures the wake button (sw-wake alias, shared with the BQ25792
	  /QON net) as a GPIO interrupt source. Disable on boards where the
	  WAKE_N line is defective: on proto0 the line reads stuck-low and,
	  with all 8 GPIOTE channels taken by other inputs, the wake pin falls
	  back to the SENSE/PORT-event mechanism — a misbehaving line there
	  produces an unbounded GPIOTE interrupt storm that starves every
	  thread (observed on 9V PD input, 2026-07-13).

config APP_TPS25750_CONFIG_9V
	bool "Use the 9V-capable TPS25750 config bundle"
	default n
	depends on TPS25750_INTERNAL_PATCH && !TPS25750_COMPRESSED_PATCH
	help
	  Selects misc/tps25750/tps25750-config-9v.c instead of the stock
	  5V-only bundle: identical ACT configuration except the sink
	  capabilities advertise a 9V PDO alongside 5V, letting the TPS25750
	  negotiate a 9V PD contract on capable chargers (the charger policy
	  then derives IINDPM/VINDPM from the contract; VAC_OVP headroom is
	  already programmed to 26V). Same byte size and symbol as the stock
	  bundle, so TPS25750_PATCH_HEADER_FILE is unchanged. NOTE: the
	  TPS25750 only accepts a patch in PTCH mode — after flashing, fully
	  power-cycle the board (USB AND battery removed) so the PD controller
	  reboots and downloads the new bundle.

config APP_CHARGER_POLICY
	bool "Charger policy engine (single owner of BQ25792 config writes)"
	default n
	depends on BQ25792 && TPS25750
	help
	  Central policy for the BQ25792 charger: disables the part's I2C
	  watchdog (whose expiry reverts EN_CHG/ICHG to POR defaults), gates
	  charge enable on battery presence (charging with no battery cycles
	  SYS to BATOVP per datasheet section 9.3.6 and brown-outs the system
	  — the proto0 no-battery reboot loop), programs VINDPM, and
	  reconciles the managed registers against external writers (the
	  TPS25750 config bundle shares the I2Cm port). Deliberately NOT
	  dependent on BT — gating must work on BLE-less builds. See
	  docs/plans/power-management-overhaul.md.

config APP_CHARGE_CURRENT_MA
	int "Default fast-charge current (ICHG) in mA"
	default 900
	range 50 5000
	depends on APP_CHARGER_POLICY
	help
	  ICHG target the charger policy programs at boot (BQ25792 REG03,
	  10mA resolution) and enforces via reconcile. Overridable at runtime
	  through the persisted BLE "Charge Current (mA)" characteristic and
	  the `power bq ichg` shell command; runtime values are clamped to
	  APP_CHARGE_CURRENT_MAX_MA. Chosen per battery pack — 900mA default
	  per the power plan. Note the TPS25750 config bundle re-programs
	  ICHG to its own value (500mA) on PD plug events; the policy
	  reconciles back within ~2s.

config APP_CHARGE_CURRENT_MAX_MA
	int "Maximum allowed fast-charge current in mA"
	default 2000
	range 50 5000
	depends on APP_CHARGER_POLICY
	help
	  Upper clamp for runtime (BLE/shell) charge-current requests —
	  protects the pack and wiring from a typo in the app. 2000mA matches
	  the chip's own 2S POR default.

config APP_INPUT_CURRENT_LIMIT_MAX_MA
	int "Maximum input current limit (IINDPM) in mA"
	default 3000
	range 100 3300
	depends on APP_CHARGER_POLICY
	help
	  Upper clamp on the IINDPM value the charger policy derives from the
	  negotiated PD contract / Type-C advertisement — bounds board input
	  wiring regardless of what a source offers. Legacy/unknown sources
	  are left on the BQ25792's own BC1.2-derived limit (unmanaged).

config APP_VINDPM_MV
	int "BQ25792 input voltage limit (VINDPM) in mV"
	default 4600
	range 3600 22000
	depends on APP_CHARGER_POLICY
	help
	  Absolute VINDPM threshold programmed at boot and enforced by the
	  charger policy's reconcile loop. 4600mV suits 5V-class sources
	  (above the 3600mV POR floor that lets a sagging source drag VBUS
	  down to unusable levels). PR C of the power plan derives this from
	  the negotiated PD contract voltage instead when a contract exists.

config APP_BATTERY_MONITOR
	bool "Battery monitoring BLE service"
	default n
	depends on BQ25792 && BT && APP_CHARGER_POLICY
	help
	  Exposes battery telemetry read from the BQ25792 charger's internal ADC
	  (battery voltage/current, VBUS voltage/current, charge status) as a
	  read/notify BLE GATT service, plus a persisted charging enable/disable
	  toggle (default ON; persistence requires APP_PERSIST_BT_CONFIG). Sampled
	  by the existing 500 ms charger status thread in src/power.cpp. Enabled
	  on rgb_sunglasses_proto0 via its board .conf; the legacy DK board
	  (dk-support branch) left it off (no new features, flash budget).

config APP_POWER_DEBUG_SERVICE
	bool "Power Debug BLE service"
	default n
	depends on APP_BATTERY_MONITOR
	help
	  Read+notify debug telemetry for the power subsystem (power plan PR
	  E): input current limit readback (IINDPM), a power-state flag
	  bitmask (battery/VBUS presence, DPM regulation, watchdog expiry,
	  charge gating), the negotiated PD source type/budget, and the ICO
	  result. Fed by the charger status thread in src/power.cpp at the
	  reconcile cadence (~2s). Enabled on rgb_sunglasses_proto0 via its
	  board .conf; the legacy DK board (dk-support branch) left it off
	  (no new features).

config APP_USB_PRODUCT_STRING
	string "USB device product string"
	default "RGB Sunglasses"
	help
	  The USB Product string descriptor reported to the host (Device
	  Manager / lsusb / etc). Overridden per-board (see board .conf
	  files) so each hardware revision reports its own name, mirroring
	  CONFIG_BT_DEVICE_NAME.

config APP_EXTENSION_HOST
	bool "Sandboxed LLEXT animation extension host"
	depends on LLEXT && USERSPACE && FAT_FILESYSTEM_ELM
	select THREAD_RUNTIME_STATS
	default n
	help
	  Discovers .llext animation extensions on /NAND:/ext at boot, loads
	  them via the llext filesystem loader, and executes their code
	  exclusively on a dedicated K_USER thread confined to a per-extension
	  memory domain (issue #85). The kernel-side pattern controller
	  exchanges data with the extension purely through the extension's own
	  exported globals (see include/rgbx/rgbx_api.h), enforcing a per-tick
	  CPU budget with abort/recreate/fallback recovery. Proto0 only — the
	  legacy DK board (dk-support branch) has neither LLEXT nor USERSPACE
	  enabled.

	  Selects THREAD_RUNTIME_STATS because the per-tick budget is charged
	  against the sandbox thread's own execution_cycles (issue #276).

config APP_EXT_FILE_TRANSFER
	bool "Allow the companion app to sync extension files over MCUmgr"
	depends on APP_EXTENSION_HOST && MCUMGR_GRP_FS
	default y
	help
	  Fences MCUmgr's file-management group to the extension directory, so
	  the companion app can hash and replace .llext files in /NAND:/ext
	  during an OTA firmware update (it compares each file's SHA256 against
	  the digest GitHub reports for the matching release asset) without
	  exposing the rest of the FAT disk over BLE.

	  Registers an MGMT_EVT_OP_FS_MGMT_FILE_ACCESS callback that rejects
	  EVERY file operation — read, write, status and hash alike — whose path
	  is not a direct child of extension_registry::kDirectory. Turning this
	  off does NOT disable file management; it removes the fence and leaves
	  CONFIG_MCUMGR_GRP_FS's default behaviour, where a bonded peer can read
	  and overwrite any path on the disk (including the MCUboot staging
	  image). Disable it only alongside CONFIG_MCUMGR_GRP_FS itself.

config APP_EXT_FILE_MANAGEMENT
	bool "Let the companion app list and delete extension files over MCUmgr"
	depends on APP_EXTENSION_HOST && MCUMGR
	default y
	help
	  Registers the FILE_MGMT custom SMP command group (id 64, see
	  fw/src/extensions/extension_mgmt.cpp and
	  fw/docs/extension-management.md): LIST (paginated union of the
	  extension directory's disk contents and the boot snapshot) and
	  DELETE (path_allowed-fenced fs_unlink, retiring the matching boot
	  slot and purging its persisted settings). This is what makes
	  remotely-uninstalling extensions — including retired ones no release
	  ships anymore — possible without USB mass storage.

	  Deliberately independent of APP_EXT_FILE_TRANSFER /
	  MCUMGR_GRP_FS: the fence predicate lives in extension_path.cpp
	  (compiled with the extension host itself), so disabling the fs_mgmt
	  group or its fence never strips the fence from this one.

# Forces on MCUmgr's SHA256 file-hash group, which the extension sync above
# depends on. This is an override of an upstream Zephyr symbol, so it needs
# justifying:
#
# MCUMGR_GRP_FS_HASH_SHA256 is declared `depends on BUILD_WITH_TFM ||
# MBEDTLS_SHA256`, and NEITHER is reachable on this build. MBEDTLS_SHA256 lives
# inside `if !(NRF_SECURITY || NORDIC_SECURITY_BACKEND)` in
# zephyr/modules/mbedtls/Kconfig.mbedtls, and this build uses nRF Security as
# its crypto backend; TF-M is not in use. Assigning either symbol in a .conf is
# silently ignored (verified by their absence from the generated autoconf.h).
#
# The dependency is stale rather than real: fs_mgmt_hash_checksum_sha256.c picks
# its backend off CONFIG_MBEDTLS_PSA_CRYPTO_CLIENT, which nRF Security DOES set
# here, so the implementation compiles and runs against PSA regardless of the
# two symbols it is gated behind.
#
# Registering our own group via the public
# fs_mgmt_hash_checksum_register_group() API was tried first and is NOT safe:
# fs_mgmt.c hashes into `char output[MCUMGR_GRP_FS_CHECKSUM_HASH_LARGEST_OUTPUT_SIZE]`,
# a stack buffer sized from Kconfig alone — 4 bytes when only CRC32 is enabled.
# A 32-byte SHA256 group registered at runtime overflows it by 28 bytes on the
# MCUmgr thread. The buffer is only sized 32 when this symbol is set, so this
# symbol is what makes SHA256 safe, not merely available.
config MCUMGR_GRP_FS_HASH_SHA256
	bool
	default y if APP_EXT_FILE_TRANSFER

config APP_EXT_HOST_THREAD_PRIORITY
	int "Extension host thread priority"
	default 9
	depends on APP_EXTENSION_HOST
	help
	  Preemptive Zephyr priority for the sandboxed extension thread. Must be
	  numerically greater than CONFIG_APP_PATTERN_CONTROLLER_THREAD_PRIORITY
	  so a runaway extension can always be preempted by the thread that
	  enforces its budget — enforced by a BUILD_ASSERT in
	  src/extensions/extension_host.cpp. See fw/docs/threading.md for the
	  system-wide priority map.

	  That assert is the ONLY schedulability property checkable at build time;
	  the sandbox's worst-case scheduling latency is not expressible here.
	  See fw/docs/threading.md, "The extension sandbox's scheduling latency is
	  unbounded — by design".

config APP_EXT_HOST_STACK_SIZE
	int "Extension host thread stack size (bytes)"
	default 2048
	depends on APP_EXTENSION_HOST

config APP_EXT_TICK_CPU_BUDGET_MS
	int "Extension tick CPU budget (ms)"
	default 50
	range 1 1000
	depends on APP_EXTENSION_HOST
	help
	  How much CPU the sandbox thread itself may consume in one tick before
	  the host declares the extension a runaway, aborts it, and falls back
	  (issue #85 recovery path).

	  This is CPU time charged to the sandbox thread, NOT elapsed wall time
	  (issue #276) — see fw/docs/threading.md for why, and for the bounds
	  that constrain this and APP_EXT_TICK_WALL_BACKSTOP_MS.

	  The default preserves the old wall-clock deadline's value, so the
	  "how much may one tick cost" contract is unchanged — only the quantity
	  being measured is corrected. Note a CPU budget is spent at the rate the
	  scheduler grants it, so a runaway on a loaded system is caught later in
	  wall terms than a flat deadline caught it; the backstop bounds the tail.

config APP_EXT_TICK_WALL_BACKSTOP_MS
	int "Extension tick wall-clock backstop (ms)"
	default 500
	range 1 10000
	depends on APP_EXTENSION_HOST
	help
	  Absolute ceiling on how long the pattern controller will wait for one
	  sandbox handshake, regardless of CPU consumed.

	  This exists only for an extension that BLOCKS rather than spins: it
	  burns no CPU, so APP_EXT_TICK_CPU_BUDGET_MS alone would never fire.
	  Keep it well above the CPU budget (a BUILD_ASSERT in
	  src/extensions/extension_host.cpp enforces the ordering) and well above
	  the worst-case time the sandbox can go unscheduled under load, or it
	  reintroduces the issue #276 false positives it exists to avoid.

	  It is also a latency ceiling, not just a fault threshold: the extension
	  host mutex is held for the whole handshake, so a blocked extension
	  stalls concurrent BLE parameter writes and `ext select` on ANY slot for
	  this long, once, before it is unloaded. Raising it widens that stall.

	  The true bound is this value PLUS one poll period (the deadline is only
	  re-checked at poll boundaries) — about 510 ms at the defaults. One
	  tick() computes a single deadline and shares it with the lazy load's
	  rgbx_init handshake, so a load followed by a tick cannot consume two
	  backstops. Size any host-side timeout against backstop + poll, not
	  against this number alone.

	  A fault from this backstop does NOT clear the extension's persisted
	  parameters — low CPU means the extension barely ran, so a bad parameter
	  cannot be the cause. See verdict_resets_params() in
	  src/extensions/extension_tick_budget.h.

config APP_BOOT_GATE_TIMEOUT_MS
	int "Boot gate timeout (ms)"
	default 30000
	help
	  How long the BT thread waits, before its first BLE advertising start,
	  for pre-advertising boot-time work (extension discovery/registration)
	  to finish (issue #208) - so a central connecting right after
	  advertising starts never reads stale/unpopulated GATT state. Not
	  gated on APP_EXTENSION_HOST: the gate always exists, since
	  pattern_controller_thread_func() always signals it once its boot-time
	  work is done, extensions or not. On timeout, a warning is logged and
	  advertising starts anyway, so a stuck FAT read during extension
	  discovery can't make the device permanently BLE-unreachable.

config APP_SHUFFLE
	bool "Animation shuffle mode"
	default y
	depends on BT
	help
	  Randomly cycles through the registered animations (issue #121),
	  skipping any the user excluded via the per-animation "Include in
	  Shuffle" characteristics (issue #243). Each animation plays for a
	  random duration between the Shuffle service's min/max
	  characteristics (seconds), then shuffle waits for the animation to
	  signal a natural switch boundary (end of text scroll, end of GLIM
	  clip; most animations signal every frame) before switching.
	  Configured over BLE via the dedicated Shuffle service
	  (src/bluetooth/shuffle_service.cpp — its own GATT table, compiled
	  only when this is enabled, hence the BT dependency); shuffle is off
	  by default at runtime.

config APP_SHUFFLE_GRACE_S
	int "Shuffle good-moment grace floor (seconds)"
	default 30
	depends on APP_SHUFFLE
	help
	  After a shuffled animation's picked duration elapses, shuffle waits
	  for its good-switch-point signal at least this long before forcing
	  the switch, so a misbehaving (e.g. extension) animation can never
	  pin shuffle on itself forever. This is a FLOOR: an animation that
	  knows exactly how far away its next natural boundary is can ask to
	  wait longer, up to APP_SHUFFLE_MAX_GRACE_S below - but can never ask
	  to wait less than this.

config APP_SHUFFLE_MAX_GRACE_S
	int "Shuffle animation-requested grace ceiling (seconds)"
	default 600
	depends on APP_SHUFFLE
	help
	  Ceiling on the extra wait an animation may REQUEST beyond
	  APP_SHUFFLE_GRACE_S when it knows how far away its next natural
	  boundary is (BaseAnimation::goodSwitchPointGraceMs()). The GLIM
	  player requests its clip's remaining runtime and the text animation
	  its remaining scroll, so a long clip (bad_apple.glim is ~3.5 min) or
	  a 255-char message plays to the end instead of being hard-cut 30 s
	  after the dwell target. Animations that do not ask - and every
	  sandboxed extension, which has no rgbx hook for this - are still
	  bounded by APP_SHUFFLE_GRACE_S alone, so the anti-hang guard still
	  covers the misbehaving-animation case it was written for. 600 s
	  covers any plausible clip; a longer one is still cut, just far
	  later. 0 disables animation-requested grace entirely.

config APP_COREDUMP_MANAGER
	bool "Coredump manager: drain crash dumps from flash to the FAT disk"
	depends on DEBUG_COREDUMP && FILE_SYSTEM
	default n
	help
	  Periodically checks the internal-flash coredump_partition (written by
	  the NCS DEBUG_COREDUMP_BACKEND_NRF_FLASH_PARTITION backend during a
	  fatal fault) for a stored dump, copies it to /NAND:/coredump/
	  core_NNNN.bin, invalidates the partition, and logs a periodic
	  reminder while dump files await collection (issue #80). Running
	  periodically — not just at boot — also harvests dumps from
	  extension-sandbox faults, which are demoted to a thread abort and
	  never reboot. Proto0 only — the legacy DK board (dk-support branch)
	  has neither the partition nor a
	  filesystem.

config APP_COREDUMP_MANAGER_INIT_PRIORITY
	int "Coredump manager SYS_INIT priority"
	default 91
	depends on APP_COREDUMP_MANAGER
	help
	  APPLICATION-phase init priority. Must be greater than
	  CONFIG_APPLICATION_INIT_PRIORITY (90), where storage.cpp mounts the
	  FAT filesystem — enforced by a static_assert in coredump_manager.cpp.

config APP_COREDUMP_WORKQ_STACK_SIZE
	int "Stack size for the coredump manager workqueue"
	default 3072
	depends on APP_COREDUMP_MANAGER
	help
	  The coredump manager does FAT filesystem I/O (fs_opendir/fs_write)
	  from its own workqueue; FATFS calls are stack-hungry (fatfs reformat
	  was measured at ~5 KB), so the 2 KB system workqueue is not used.

config APP_COREDUMP_REMINDER_PERIOD_S
	int "Seconds between coredump partition polls (also the dump-loss window)"
	default 60
	range 1 3600
	depends on APP_COREDUMP_MANAGER
	help
	  How often the manager polls the coredump partition and drains any new
	  dump to /NAND:/coredump.

	  This is NOT just a logging or polling knob. The flash backend erases
	  the whole coredump partition at the start of every capture, so a dump
	  that has not been drained yet is destroyed by the next fault. This
	  period is therefore the window in which a second crash overwrites the
	  first — the case that matters most on a boot-looping board or a
	  repeatedly faulting extension sandbox. Raising it trades dump
	  retention for fewer FAT wakeups; do not raise it to quiet logs.

	  Use `coredump_mgr status` to check for uncollected dumps on demand.

config APP_CRASH_TEST_COMMANDS
	bool "Shell commands that deliberately crash the firmware"
	depends on SHELL
	default n
	help
	  Registers the `crash` shell command (`crash panic`, `crash mpu`) for
	  exercising the fatal-error path end-to-end: coredump capture,
	  reboot-on-fault, and the coredump manager's copy-to-FAT flow
	  (issue #80).

config STATUS_LED
	bool "Onboard status LED module (led_strip_2)"
	depends on LED_STRIP && WS2812_STRIP_SPI
	default n
	help
	  Drives the two onboard WS2812 status LEDs (led_strip_2) from a
	  dedicated thread with solid, blinking, and breathing animations.
	  When enabled, led_controller does not manage led_strip_2.

config NETCORE_VERSION_IPC
	bool "Query running net core version via IPC"
	depends on IPC_SERVICE
	help
	  Registers an IPC endpoint (NETCORE_VER) on ipc0 at startup.
	  The net core responds with its running firmware version and
	  SHA256 hash; the result is cached and surfaced through the
	  net_core_sim_flash driver so MCUMgr img_list reports real data.

if NETCORE_VERSION_IPC

module = NETCORE_VERSION
module-str = "netcore_version"
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif # NETCORE_VERSION_IPC

config MCUBOOT_INFO_INIT_PRIORITY
	int "MCUboot info service init priority"
	default 88
	help
	  The init priority of the MCUboot info service. Lower numbers are
	  initialized first. The default is 88, which is one-higher than CONFIG_RETENTION_BOOTLOADER_INFO_INIT_PRIORITY.

menu "Thread priorities and stack sizes"

# Zephyr priority convention, shared by every priority symbol in this menu:
#
#   negative  = cooperative (the K_PRIO_COOP band, -CONFIG_NUM_COOP_PRIORITIES .. -1).
#               A cooperative thread is NEVER preempted — not by a preemptible thread,
#               and not by a higher-priority cooperative one either. It runs until it
#               blocks or sleeps.
#   0 .. CONFIG_NUM_PREEMPT_PRIORITIES-1 = preemptible. Lower number = higher priority.
#
# Setting a thread cooperative is a deliberate act with system-wide consequences, not a
# way to "make it faster". In particular a thread that does filesystem or flash I/O must
# stay preemptible (see fw/CLAUDE.md's coding rules — a long flash write from a
# cooperative thread starves everything else).
#
# Not every thread in the system is configured here: the Bluetooth host/controller
# threads and Zephyr's system workqueue are all cooperative and therefore outrank every
# preemptible thread below no matter what you set. fw/docs/threading.md has the full
# system-wide map and the ordering invariants; read it before changing any default here.

config APP_LED_DISPLAY_THREAD_PRIORITY
	int "LED display thread priority"
	default 2
	help
	  Priority for led_display_thread (src/led_controller.cpp), which clocks
	  the most recently rendered framebuffer out to the WS2812 strips once
	  per core/display_thread_rate_ms. This is the only thread in the system
	  with a hard frame deadline, so it should outrank every other
	  application thread. Must be numerically lower (higher priority) than
	  APP_PATTERN_CONTROLLER_THREAD_PRIORITY — enforced by a BUILD_ASSERT in
	  led_controller.cpp.

	  The default of 2 is chosen to sit ABOVE the mcumgr SMP transport
	  workqueue, which Zephyr fixes at CONFIG_MCUMGR_TRANSPORT_WORKQUEUE_THREAD_PRIO
	  = 3. Sharing 3 with it was measured to cost a whole dropped frame
	  (max wake-to-wake 63.8 ms vs 43.2 ms) whenever the app's SMP link was
	  active, because equal preemptible priorities round-robin at the 20 ms
	  CONFIG_TIMESLICE_SIZE — the same collision this change set out to remove.

	  Keep it preemptible (>= 0). Making it cooperative does NOT let it
	  preempt the cooperative Bluetooth/system-workqueue threads that cause
	  the issue-#267 stutter — a running cooperative thread is never
	  preempted by anything (zephyr/kernel/include/kthread.h,
	  should_preempt()) — it would only stop the BLE radio threads from
	  preempting the display thread, which is strictly worse.

config APP_LED_DISPLAY_THREAD_STACK_SIZE
	int "LED display thread stack size (bytes)"
	default 4096
	help
	  Kernel-only stack: the thread is created with K_KERNEL_THREAD_DEFINE,
	  which skips the 1KB CONFIG_USERSPACE privileged stack, so this stack
	  can never host a K_USER thread.

config APP_PATTERN_CONTROLLER_THREAD_PRIORITY
	int "Pattern controller (render) thread priority"
	default 4
	help
	  Priority for pattern_controller_thread (src/pattern_controller.cpp),
	  which ticks the active animation into a framebuffer once per
	  core/render_thread_rate_ms.

	  Keep this preemptible: the thread also does FAT/QSPI I/O (GLIM asset
	  reads, .llext loads) and settings persistence, which fw/CLAUDE.md
	  forbids from a cooperative thread.

	  Both APP_EXT_HOST_THREAD_PRIORITY and IMU_THREAD_PRIORITY must be
	  numerically greater than this value; BUILD_ASSERTs enforce it.

config APP_PATTERN_CONTROLLER_THREAD_STACK_SIZE
	int "Pattern controller (render) thread stack size (bytes)"
	default 4096
	help
	  Kernel-only stack (K_KERNEL_THREAD_DEFINE). Extension code runs on the
	  extension host's own K_USER sandbox thread, never on this one, so this
	  stack never needs the CONFIG_USERSPACE privileged reservation.

config APP_BT_THREAD_PRIORITY
	int "Application Bluetooth state-machine thread priority"
	default 6
	help
	  Priority for bt_thread (src/bluetooth.cpp) — the application's own
	  advertising/connection state machine, NOT the Bluetooth host or
	  controller threads (those are cooperative and are configured by
	  CONFIG_BT_RX_PRIO / CONFIG_BT_HCI_TX_PRIO / CONFIG_BT_DRIVER_RX_HIGH_PRIO).
	  This thread has no deadline: it blocks on a K_MSGQ and reacts to
	  connection callbacks.

config APP_BT_THREAD_STACK_SIZE
	int "Application Bluetooth state-machine thread stack size (bytes)"
	default 2048
	help
	  Verified against real connect/disconnect/GATT-write traffic (issue
	  #75): the high-water mark stayed at 724 B out of the previous 8096 B
	  budget, so 2048 B leaves ~2.8x margin. Kernel-only stack
	  (K_KERNEL_THREAD_DEFINE).

config APP_STATUS_LED_THREAD_PRIORITY
	int "Status LED thread priority"
	default 8
	depends on STATUS_LED
	help
	  Priority for status_led_thread (src/status_led/status_led.cpp), which
	  drives the two onboard WS2812 status LEDs. Cosmetic and low-rate — it
	  should sit below the frame-deadline threads.

config APP_STATUS_LED_THREAD_STACK_SIZE
	int "Status LED thread stack size (bytes)"
	default 2048
	depends on STATUS_LED
	help
	  Kernel-only stack (K_KERNEL_THREAD_DEFINE).

config APP_AUDIO_DSP_THREAD_PRIORITY
	int "Audio DSP thread priority"
	default 5
	depends on AUDIO
	help
	  Priority for audio_dsp_thread (src/sound/sound.cpp), which runs the
	  PDM capture, AGC and CMSIS-DSP FFT pipeline feeding the beat/fft_bars
	  animations.

	  This was cooperative (-7) until issue #267. A running cooperative
	  thread is never preempted, so an FFT could stall rendering for its
	  full duration. It is now preemptible and ranked below both rendering
	  threads. Keep it there — see fw/docs/threading.md.

config APP_AUDIO_DSP_THREAD_STACK_SIZE
	int "Audio DSP thread stack size (bytes)"
	default 2048
	depends on AUDIO
	help
	  Verified against real beat/fft_bars animation load (issue #75): the
	  high-water mark stayed at 692 B out of the previous 8096 B budget, so
	  2048 B leaves ~3x margin, including headroom for K_FP_REGS' FPU
	  context save. Kernel-only stack (K_KERNEL_THREAD_DEFINE).

config APP_AUDIO_DEBUG
	bool "Audio beat-detection debug instrumentation"
	default n
	depends on AUDIO
	help
	  Compiles in the beat-detection MEASUREMENT surface (issue #264): the
	  audio tap queue that lets "sound mic record_wav" write its per-frame
	  analysis sidecar CSV and "sound dump" stream live frames, plus the
	  "sound agc freeze" and "sound agc gain" shell commands.

	  Default n: this is developer instrumentation, not a shipped feature,
	  and it is the single largest reclaimable block of static RAM in the
	  application image. Enable it for a beat-detection debugging session:

	    west build --build-dir fw/build fw --board \
	      rgb_sunglasses_proto0/nrf5340/cpuapp --sysbuild -- \
	      -DBOARD_ROOT="$(pwd)/fw" -DCONFIG_APP_AUDIO_DEBUG=y

	  NOTE a Kconfig *default* change is ignored by an incremental build
	  (see fw/CLAUDE.md), so switching this on or off against an existing
	  fw/build needs "rm fw/build/fw/zephyr/.config" first, or --pristine.
	  Verify it landed in build/fw/zephyr/include/generated/zephyr/autoconf.h
	  before drawing conclusions from a capture.

	  What stays available when this is OFF: "sound dsp params"/"sound dsp
	  set" (every detector tunable), "sound agc status"/"gate"/"rate"/
	  "attack"/"release", "sound rms", and "sound mic record_wav" itself —
	  which falls back to a direct raw capture, so you still get a WAV, just
	  without the analysis sidecar. Field tuning therefore does not need this
	  option; only device-vs-host replay comparison does.

	  See fw/docs/beat-detection-debugging.md.

config APP_CHARGER_STATUS_THREAD_PRIORITY
	int "Charger status thread priority"
	default 8
	help
	  Priority for charger_status_thread (src/power.cpp), which polls the
	  BQ25792 over the TPS25750 I2Cm bridge and drives the charge-status LED
	  colour. Low-rate and cosmetic — keep it below the rendering threads.

config APP_CHARGER_STATUS_THREAD_STACK_SIZE
	int "Charger status thread stack size (bytes)"
	default 1024
	help
	  Kernel-only stack (K_KERNEL_THREAD_DEFINE).

	  Measured on proto0 hardware at 912 B of 1024 B used (89%), so there is
	  very little headroom left here — re-check `kernel thread list` after
	  adding anything to this thread's call path.

config APP_PERSIST_WORKQ_PRIORITY
	int "Priority for the persistent-value-store workqueue"
	default 14
	depends on APP_PERSIST_BT_CONFIG
	help
	  Priority for the workqueue that flushes debounced config writes to
	  flash (src/settings/persistent_value_store.cpp). It does long, bursty
	  NVS/QSPI work, so it must be the lowest-priority preemptible thread in
	  the system. The default matches CONFIG_NUM_PREEMPT_PRIORITIES - 1, and
	  a BUILD_ASSERT re-checks that relationship.

config APP_COREDUMP_WORKQ_PRIORITY
	int "Priority for the coredump manager workqueue"
	default 14
	depends on APP_COREDUMP_MANAGER
	help
	  Priority for the workqueue that drains crash dumps to
	  /NAND:/coredump (src/debug/coredump_manager.cpp). Does FAT filesystem
	  I/O, so it must be the lowest-priority preemptible thread in the
	  system. Same reasoning and BUILD_ASSERT as
	  APP_PERSIST_WORKQ_PRIORITY.

config APP_MCUBOOT_UPDATER_WORKQ_PRIORITY
	int "Priority for the MCUboot updater workqueue"
	default 14
	depends on APP_MCUBOOT_UPDATER
	help
	  Priority for the workqueue that erases, validates and rewrites the
	  bootloader region (src/mcuboot_updater.cpp). Page-by-page internal
	  flash rewrites are the longest-running flash operation in the
	  firmware, so it must be the lowest-priority preemptible thread in the
	  system. Same reasoning and BUILD_ASSERT as
	  APP_PERSIST_WORKQ_PRIORITY.

endmenu

rsource "drivers/Kconfig"
config APP_LED_SEGMENT_CPU_ATTRIBUTION
	bool "Per-segment CPU attribution for the display thread"
	default y
	select THREAD_RUNTIME_STATS
	select SCHED_THREAD_USAGE
	select SCHED_THREAD_USAGE_ALL
	select SCHED_THREAD_USAGE_AUTO_ENABLE
	help
	  Records, for each display-thread segment, how its wall time split between
	  this thread's own CPU, other threads, and idle — so an overrun can say
	  whether the thread was slow, starved, or blocked waiting on hardware.

	  This carries its dependencies with it rather than relying on the board conf,
	  following APP_EXTENSION_HOST's "select THREAD_RUNTIME_STATS" precedent.
	  led_controller.cpp is compiled into every board build and #errors without
	  these symbols, so without the selects the first ROM-reduction pass that
	  turned off the board conf's debug/instrumentation cluster would fail the
	  whole firmware link from a file it never touched. Turn this off to drop the
	  instrumentation deliberately; the overrun warning then reports wall time
	  only and offers no verdict.
