# editors
*.swp
*~


# Pycache
__pycache__/

.coverage

.pytest_cache/

.claude/settings.local.json
.claude/worktrees/

.serial_mcp/traces/

# Generated Pages docs — produced by scripts/build-site.py (in CI and for local
# preview). The Markdown under fw/docs/ (and the DOCS manifest) is the source of
# truth; don't commit or hand-edit these. Add one line per generated doc dir.
site/docs/
site/recovery/
site/proto0-user-guide/
site/proto0-assembly-guide/
site/proto0-hardware-guide/
site/developer-setup/
# The extension simulator bundle (vite build output copied in by pages.yml).
site/sim/

# Beat-detection tuning corpus (issue #264). Deliberately NOT committed: the
# clips are large (~2 MB per 60 s WAV) and cheap to regenerate — see
# fw/docs/beat-detection-debugging.md for the record/pull workflow. Keeping
# them here (untracked) lets one tuning effort span sessions without putting
# audio in git history.
fw/testdata/beat-corpus/

# Twister output — build trees, ELF/object binaries and per-suite logs, regenerated
# by every `twister -T fw/tests` run. Written to the repo root when twister is invoked
# from there (the documented way), so it is not covered by fw/build ignores.
twister-out/
twister-out.*/
